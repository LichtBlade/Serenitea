<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Serenitea"
        tools:targetApi="31">
        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.StatusItemPageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.authentication.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".ui.authentication.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CompletedActivity"
            android:exported="false" />
        <activity
            android:name=".ui.order.OutForDeliveryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.order.PreparingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ConfirmationActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CartActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AddCard"
            android:exported="false" />
        <activity
            android:name=".ui.HomeActivity"
            android:exported="false" /> <!-- Main Activity (the entry point) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>